{
  "name": "inspectrum",
  "version": "0.2.3",
  "description": "Automatic Codex plan review in Claude Code; on-demand in local MCP hosts; human approval stays yours",
  "type": "module",
  "bin": {
    "inspectrum": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "PRIVACY.md",
    "docs/",
    "server.json",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "verify:mcpb": "node scripts/verify-mcpb.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "check:submission": "node scripts/check-submission-readiness.mjs",
    "dev": "node --import tsx/esm src/server.ts",
    "prepack": "npm run build && npx tsc --noEmit && npx eslint src/ && npm run test:coverage",
    "e2e:gate": "bash scripts/e2e-plan-gate.sh"
  },
  "keywords": [
    "mcp",
    "plan-review",
    "llm",
    "claude",
    "codex",
    "gemini",
    "multi-llm",
    "claude-code",
    "codex-cli",
    "plan-mode",
    "coding-agent"
  ],
  "author": "Yann Menec",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannmenec/inspectrum.git"
  },
  "homepage": "https://github.com/yannmenec/inspectrum#readme",
  "bugs": {
    "url": "https://github.com/yannmenec/inspectrum/issues"
  },
  "mcpName": "io.github.yannmenec/inspectrum",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.3.0",
    "lefthook": "^2.1.6",
    "nock": "^14.0.14",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "external-editor": {
      "tmp": "0.2.7"
    }
  }
}
