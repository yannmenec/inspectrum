{
  "name": "inspectrum",
  "version": "0.1.0",
  "description": "Universal MCP server for multi-LLM plan review",
  "type": "module",
  "bin": {
    "inspectrum": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "dev": "node --import tsx/esm src/server.ts",
    "prepack": "npm run build && npx tsc --noEmit && npx eslint src/ && npm run test:coverage"
  },
  "keywords": [
    "mcp",
    "plan-review",
    "llm",
    "claude",
    "codex",
    "gemini",
    "multi-llm"
  ],
  "author": "Yann Menec",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "lefthook": "^2.1.6",
    "nock": "^14.0.14",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
